{
  "name": "news-pulse",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:e2e": "playwright test",
    "dev:database": "node scripts/local-database.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^10.4.1",
    "prettier": "^3.9.8"
  },
  "engines": {
    "node": ">=22"
  }
}
